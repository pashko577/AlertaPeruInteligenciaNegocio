# Copia este archivo como .env (en la carpeta backend/) y completa los valores.
# NUNCA subas el archivo .env al repositorio.
#
# Usa un usuario de Atlas con rol de SOLO LECTURA
# (Atlas > Security > Database Access > Add New Database User > "Only read any database").
MONGODB_URI=mongodb+srv://USUARIO_LECTURA:CONTRASENA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DATABASE=alerta_peru
SERVER_PORT=8080
