# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env al repositorio ni lo compartas.

# Cadena de conexión de MongoDB Atlas (Atlas > Connect > Drivers > Python).
# Usa el usuario del ETL (lectura y escritura).
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos
MONGODB_DATABASE=alerta_peru

# Rutas (opcionales; por defecto se usan las del proyecto)
# CSV_PATH=../BD_2003-2025_EMERGENCIAS.csv
# GEOJSON_DIR=../data/referencias/peru-geojson-2023/data/variants/light
